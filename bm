#!/usr/bin/env bash
# =============================================================================
# BLIP Benchmark Suite
# =============================================================================
# Runs the Zig varint microbenchmarks (encode/decode throughput, bignum,
# random-access) across all encodings. Always ReleaseFast, never Debug.
#
# (Archive-creation benchmarks moved out with the blar repo in the v3 split.)
# TODO: emit a `DEBUG BUILD` announcement from the BLIP binaries so a guard
#       here can assert release-only, per the benchmark convention.
# =============================================================================

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                    BLIP Benchmark Suite                     ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""

echo "Building (ReleaseFast)..."
nix develop -c zig build -Doptimize=ReleaseFast 2>/dev/null \
    || { echo "FATAL: build failed"; exit 1; }

echo ""
echo "━━━ Zig Encoding Benchmarks ━━━"
nix develop -c zig build bench -Doptimize=ReleaseFast \
    || { echo "FATAL: benchmark failed"; exit 1; }

echo ""
echo "Done."
