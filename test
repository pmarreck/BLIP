#!/usr/bin/env bash
set -u

# =============================================================================
# BLIP Master Test Runner
# =============================================================================
# After the Phase 1 split, BLIP has no shell tests — every CLI test in tests/
# moved with the blar repo (along with the binaries those tests drive).  All
# coverage now lives in the Zig unit tests embedded in each module.
# =============================================================================

echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                   BLIP Master Test Suite                    ║"
echo "╚══════════════════════════════════════════════════════════════╝"

echo ""
echo "Building (ReleaseFast)..."
nix develop -c zig build -Doptimize=ReleaseFast 2>/dev/null \
    || { echo "FATAL: build failed"; exit 1; }

echo ""
echo "━━━ Zig Unit Tests ━━━"
nix develop -c zig build test --summary all
zig_rc=$?

echo ""
echo "━━━ blip CLI Tests ━━━"
nix develop -c bash tests/cli/blip_cli_test.sh
cli_rc=$?

exit $(( zig_rc | cli_rc ))
