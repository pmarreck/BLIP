#!/usr/bin/env luajit
-- blip — self-describing byte-order transcoder built on the BLIP varint frame.
--
-- BLIP frames arbitrary binary data as ONE length-prefixed value whose header
-- carries an explicit endianness (E) bit, so the byte order is never implicit
-- (the bug class BLIP exists to kill; see README).  This tool exposes that as a
-- Unix filter:
--
--   encode  reads raw bytes on stdin, writes a BLIP frame on stdout.
--           -b/--big (default) / -l/--little DECLARE the input's byte order;
--           the payload is stored VERBATIM and the E bit is stamped. Encode
--           never reverses.
--
--   decode  reads a BLIP frame on stdin, writes the payload on stdout.
--           -b/--big (default) / -l/--little REQUIRE the output's byte order;
--           the frame's E bit says how it is stored, and decode converts to the
--           requested target (same order => verbatim, cross order => reversed).
--           Default target is big-endian == stream/network order, so `decode`
--           normalizes everything to a stable big-endian fixpoint.
--
-- Both refuse to write raw binary to an interactive terminal (pipe to a file or
-- a tool like `xxd` / `printable-binary`, or pass -f/--force).

local ffi = require("ffi")
ffi.cdef[[ int isatty(int fd); ]]

local VERSION = "3.0.0"

-- ---------------------------------------------------------------------------
-- small helpers
-- ---------------------------------------------------------------------------

local function die(msg, code)
	io.stderr:write(msg)
	os.exit(code or 1)
end

-- stdout_is_tty: true if fd 1 is an interactive terminal. BLIP_TTY env var
-- forces the answer (1/0) so the guard branch is testable without a real pty.
local function stdout_is_tty()
	local env = os.getenv("BLIP_TTY")
	if env == "1" then return true end
	if env == "0" then return false end
	return ffi.C.isatty(1) ~= 0
end

-- stdin_is_tty: mirror of stdout_is_tty for fd 0 (BLIP_STDIN_TTY overrides).
-- Used to show help instead of blocking on a read when `blip` is run bare and
-- interactively.
local function stdin_is_tty()
	local env = os.getenv("BLIP_STDIN_TTY")
	if env == "1" then return true end
	if env == "0" then return false end
	return ffi.C.isatty(0) ~= 0
end

-- ---------------------------------------------------------------------------
-- codec (pure functions over strings)
-- ---------------------------------------------------------------------------

-- encode: frame `data` as a single BLIP value. `endian_be` stamps the E bit;
-- payload is stored verbatim (never reversed). A lone byte < 0x80 is emitted in
-- immediate mode (bare byte) — both to stay canonical and to avoid colliding
-- with BLIP's reserved sentinels (overlong L=1,E=0,payload<0x80).
local function encode(data, endian_be)
	local n = #data
	if n == 1 and data:byte(1) < 0x80 then
		return data
	end
	local ebit = endian_be and 0x40 or 0x00
	if n < 0x20 then
		return string.char(0x80 + ebit + n) .. data
	end
	-- length >= 32: low 5 bits inline, remainder as LE 7-bit continuation varint
	local bytes = { 0x80 + ebit + 0x20 + (n % 0x20) }
	local rem = math.floor(n / 0x20)
	while rem >= 0x80 do
		bytes[#bytes + 1] = 0x80 + (rem % 0x80)
		rem = math.floor(rem / 0x80)
	end
	bytes[#bytes + 1] = rem % 0x80
	return string.char(unpack(bytes)) .. data
end

-- decode: parse a single BLIP frame from `data`, returning the payload in the
-- requested `target_be` byte order. Errors (truncation, trailing data, reserved
-- sentinel) call die(). Cross-order requests reverse the payload; 0/1-byte
-- payloads and immediate values are order-invariant.
local function decode(data, target_be)
	local n = #data
	if n == 0 then die("blip decode: empty input, no BLIP frame\n", 3) end
	local b = data:byte(1)
	if b < 0x80 then
		if n > 1 then
			die(("blip decode: trailing data after immediate value (%d extra byte(s))\n"):format(n - 1), 3)
		end
		return string.char(b)
	end
	local frame_be = (math.floor(b / 0x40) % 2) == 1   -- bit 6 = E (1 = BE)
	local L = b % 0x20                                  -- low 5 bits of length
	local pos = 2
	if (math.floor(b / 0x20) % 2) == 1 then             -- bit 5 = continuation
		local shift = 5
		while true do
			if pos > n then die("blip decode: truncated length continuation\n", 3) end
			local c = data:byte(pos); pos = pos + 1
			L = L + (c % 0x80) * (2 ^ shift)
			shift = shift + 7
			if c < 0x80 then break end
		end
		L = math.floor(L + 0.5)                          -- collapse 2^shift float math
	end
	local last = pos + L - 1
	if last > n then
		die(("blip decode: truncated payload (need %d byte(s), have %d)\n"):format(L, n - pos + 1), 3)
	end
	if last < n then
		die(("blip decode: trailing data after frame (%d extra byte(s))\n"):format(n - last), 3)
	end
	local payload = data:sub(pos, last)
	if L == 1 and (not frame_be) and payload:byte(1) < 0x80 then
		die(("blip decode: reserved sentinel encoding (0x81 0x%02X), not a data frame\n"):format(payload:byte(1)), 4)
	end
	if L <= 1 or target_be == frame_be then
		return payload
	end
	return payload:reverse()
end

-- ---------------------------------------------------------------------------
-- CLI
-- ---------------------------------------------------------------------------

local function usage(out)
	out:write([[
blip ]] .. VERSION .. [[ — self-describing byte-order transcoder (BLIP frames)

USAGE:
  blip encode [-b|-l] [-f] < raw   > frame
  blip decode [-b|-l] [-f] < frame > raw

  encode  Frame stdin as one BLIP value. -b/--big (default) or -l/--little
          DECLARE the input's byte order; payload is stored verbatim.
  decode  Unframe stdin. -b/--big (default) or -l/--little REQUIRE the output
          byte order; decode converts from the frame's stored order.

OPTIONS:
  -b, --big       big-endian (default; stream/network order)
  -l, --little    little-endian
  -f, --force     write even if stdout is a terminal
  -h, --help      show this help
      --about     one-line description and version

Both commands emit raw binary — pipe to a file or a tool like `xxd` /
`printable-binary`. They refuse an interactive terminal unless -f is given.
]])
end

local function about()
	io.write(("blip %s — BLIP self-describing varint framing, encode/decode (%s/%s)\n")
		:format(VERSION, jit.os, jit.arch))
end

-- Resolve the subcommand. `encode` is the default verb so `blip` behaves as a
-- plain filter (`… | blip`, `blip -l < f`); an interactive bare invocation with
-- no piped data shows help instead of blocking on a stdin read.
local a1 = arg[1]
local sub, flag_start
if a1 == "-h" or a1 == "--help" then usage(io.stdout); os.exit(0)
elseif a1 == "--about" then about(); os.exit(0)
elseif a1 == "encode" or a1 == "decode" then sub, flag_start = a1, 2
elseif a1 == nil then
	if stdin_is_tty() then usage(io.stdout); os.exit(0) end
	sub, flag_start = "encode", 2
elseif a1:sub(1, 1) == "-" then sub, flag_start = "encode", 1   -- leading flag, no verb
else die("blip: unknown subcommand '" .. a1 .. "' (expected encode|decode)\n", 2) end

local endian_be = true   -- default big-endian (declaration on encode / target on decode)
local force = false
for i = flag_start, #arg do
	local a = arg[i]
	if a == "-b" or a == "--big" then endian_be = true
	elseif a == "-l" or a == "--little" then endian_be = false
	elseif a == "-f" or a == "--force" then force = true
	elseif a == "-h" or a == "--help" then usage(io.stdout); os.exit(0)
	else die("blip " .. sub .. ": unknown argument '" .. a .. "'\n", 2) end
end

local data = io.stdin:read("*a") or ""
local out = (sub == "encode") and encode(data, endian_be) or decode(data, endian_be)

if #out > 0 and stdout_is_tty() and not force then
	die("blip: refusing to write raw binary to a terminal (it would corrupt your display).\n" ..
	    "  Pipe it to a file or a tool like `xxd` or `printable-binary`, or pass -f/--force.\n", 1)
end
io.stdout:write(out)
