# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
close=[
	.claude
	.direnv
	.git
	.github
	.jj
	.zig-cache
]

annotate=[
	BLIP_CONTAINER_SPEC.md = 
	BLIP_SPEC.md = Canonical BLIP varint spec: length-prefix mode, endianness (E) bit, sentinels + scalar sentinels (TRUE/FALSE/NIL), signed handling, invariants, encoding comparisons. (Concise variant merged in 2026-07-02.)
	BLIP_SPEC_CONCISE.md = 
	BLIP_WIRE_SPEC.md = Generic BLIP wire-format spec: LP envelope + attribute framework, scalar sentinels, ARRAY/DICT/MAP/UTF8/DATA/RAW, SEGMENT, optional COMP/CSUM/ENC, streaming/scratch, determinism, printable-binary + JSON human-readable forms. (Archive layer split to blar 2026-07-02.)
	bin/blip = Self-describing byte-order transcoder CLI (LuaJIT): encode/decode BLIP frames; -b/-l declare (encode) or require (decode) byte order; refuses raw binary to a TTY. Lives in bin/ for PATH pickup.
	blip = 
	bm = Benchmark entry-point script (ReleaseFast).
	build = Entry-point script: nix build -> zig-out/bin (ReleaseFast; --debug/--test variants).
	build.zig = Build: libblip.a, blip-bench, blip-benchmark, printable-binary; runs unit + FFI tests.
	build.zig.zon = Zig package manifest (no external deps after the v3 split).
	docs/transport_embedding.md = Disk-files convention for SEGMENT-based archive splitting.
	flake.nix = Nix dev shell (zig, hyperfine, luajit) + packages.default + checks.default (Garnix-evaluated; runs zig tests + blip CLI tests).
	src/array.zig = ARRAY container: fixpoint length iteration, index tables, xxHash64. Readers: elementBytesAt (raw span, scalar-aware) + containerAt (parse-as-container; renamed from elementAt to document the assumption).
	src/asn1_length.zig = ASN.1 BER length encoding (benchmark comparison encoding).
	src/benchmark.zig = blip-benchmark binary: throughput + bignum + random-access across all 6 varints.
	src/bignum.zig = Direct LE-byte arithmetic (add/mul/compare) for arbitrary-precision benchmarks.
	src/blip.h = C declarations matching src/lib.zig, consumed by downstream projects.
	src/blip.zig = BLIP varint encode/decode; sentinel handling; scalar sentinels (TRUE/FALSE/NIL); encodedSize.
	src/checksum.zig = compute(id,data)/verify(id,data,expected): xxHash64, CRC32, BLAKE3-128.
	src/container.zig = LP-envelope mechanics: parseLPHeader, computeLPLength, attribute parse/serialize.
	src/container_types.zig = Type IDs (ARRAY/DICT/MAP/FILE/DIR/DATA/UTF8), checksum/encryption IDs, attribute sigils, scalar sentinels.
	src/dict.zig = DICT/MAP/DIR containers: sorted keys, interleaved index, xxHash64; DictReader.findKey (binary search); valueAt now scalar-aware (offset-delta span, not parseLPHeader) so values may be bare scalars; DictIndex opt-in O(1)/O(log n) accelerator.
	src/encoding.zig = all_encodings tuple for comptime iteration across the 6 varints (common interface).
	src/fuzz.zig = Fuzz roundtrip tests (100K random values per encoding).
	src/json.zig = Generic lossless container<->JSON codec: toJson (wire->JSON) + fromJson (JSON->wire, sorts dict keys canonically); pinned tags $int/$b/$blip. wire->JSON->wire is byte-identical (MFIC round-trip oracle).
	src/leaf.zig = UTF8 + DATA leaf containers (serialize/parse).
	src/leb128.zig = LEB128/SLEB128 varint (benchmark comparison encoding).
	src/lib.zig = export fn declarations for every BLIP C-callable function (varint, peek, segment, printable-binary, xxhash, DictIndex, free, error_string).
	src/main.zig = blip-bench binary: smoke-tests the C FFI from a Zig main().
	src/peek.zig = Generic LP-envelope path traversal: parsePath('[0][meta]'), navigate, containerCount/Hash/KeyAt, peekDisplay.
	src/prefix_varint.zig = PrefixVarint (benchmark comparison encoding, fixed <=64-bit).
	src/protobuf_varint.zig = Protocol Buffers varint + ZigZag (benchmark comparison encoding).
	src/segmentation.zig = Layer 5 SEGMENT primitive: chunkBytes, reassemble, parseSegment.
	src/sqlite_varint.zig = SQLite varint (benchmark comparison encoding, fixed <=64-bit).
	src/value.zig = Value classifier at DICT-value/ARRAY-element positions (BLIP_WIRE_SPEC §Scalar values): classify() → bare integer / TRUE-FALSE-NIL sentinel / LP container; 3-rule mutually-exclusive disambiguation.
	test = Master test runner: zig unit tests + blip CLI tests (tests/cli), accumulates exit code.
	tests/cli/blip_cli_test.sh = Bash CLI tests for the blip encode/decode tool (34 cases: framing, endian transcode, roundtrip/fixpoint, TTY guard, error paths)
	vendor/printable_binary/main.zig = Vendored printable-binary CLI main().
	vendor/printable_binary/printable_binary.zig = Vendored UTF-8 printable-binary encoder/decoder; backs blip_*_printable_binary FFI + printable-binary CLI.
]
